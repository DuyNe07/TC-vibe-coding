# ---- App ----
APP_NAME="TC Vibe Coding"
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_DATA_DIR=data
APP_PORT=8501  

# ---- Database: PostgreSQL shared by every developer (empty POSTGRES_IP = local SQLite file data/app.db) ----
POSTGRES_IP=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DATABASE_URL=
APP_DB_AUTO_CREATE=true

# ---- Accounts ----
APP_SESSION_HOURS=12


# ---- Volume guards: big data never freezes the app (raise only if the server really copes) ----
APP_DB_WARN_ROWS=200000        # a table read with more rows logs a WARNING
APP_EXCEL_MAX_ROWS=200000      # ExcelReader refuses bigger sheets
APP_TABLE_MAX_ROWS=200000      # data_table shows at most this many rows
APP_SELECT_MAX_ROWS=10000      # data_table with row selection
APP_EDIT_MAX_ROWS=5000         # editable_table: bigger tables become read-only
APP_CHART_MAX_POINTS=5000      # points per line in line_chart
APP_CHART_MAX_CATEGORIES=30    # bars / slices before grouping into "Khác"

# ---- Network (only if the company network needs a proxy to fetch public web pages) ----
# HTTP_PROXY=
# HTTPS_PROXY=
